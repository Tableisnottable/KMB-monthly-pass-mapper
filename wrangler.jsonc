{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kmb-monthly-pass-mapper",
  "minify": true,
  "main": ".free-worker/worker.js",
  "compatibility_date": "2026-11-13",
  "durable_objects": { "bindings": [{ "name": "JOURNEY_NOTIFICATIONS", "class_name": "JourneyNotifications" }] },
  "migrations": [{ "tag": "v1-boarding-notifications", "new_sqlite_classes": ["JourneyNotifications"] }],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": ".free-worker/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/en*", "/macau*", "/routes*", "/timetables*", "/traffic*", "/updates*", "/install*", "/coverage*", "/world*", "/asia*", "/japan*", "/taiwan*", "/api/*"],
    "not_found_handling": "404-page"
  }
}
