{
  "name": "tableisnottable-supreme-sniffle",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/build-browser-worker.mjs && next dev",
    "build": "node scripts/build-browser-worker.mjs && next build --webpack",
    "cf:build": "npm run build && node scripts/stage-free-worker.mjs",
    "cf:preview": "npm run cf:build && wrangler dev --config wrangler.jsonc",
    "cf:deploy": "npm run cf:build && wrangler deploy --config wrangler.jsonc",
    "start": "node scripts/build-browser-worker.mjs && next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:browser": "node scripts/build-browser-worker.mjs && node scripts/test-browser-worker.mjs",
    "data:citybus": "node scripts/fetch-citybus-data.mjs",
    "data:transport": "python scripts/import-transport.py",
    "data:residents": "python scripts/import-residents.py"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "fast-xml-parser": "^5.12.1",
    "leaflet": "^1.9.4",
    "next": "^16.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.6.0",
    "esbuild": "^0.25.12",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.4.5",
    "vitest": "^2.1.9",
    "wrangler": "^4.162.0"
  }
}
