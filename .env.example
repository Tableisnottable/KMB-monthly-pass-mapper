# Optional Google Maps Embed URL. If omitted, the app uses a Hong Kong map fallback.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps?q=Hong+Kong&output=embed

# Optional private OSRM services for production walking and road fallback paths.
# Defaults use the public FOSSGIS demonstration service with caching/rate limits.
# OSRM_FOOT_URL=https://your-router/route/v1/foot
# OSRM_CAR_URL=https://your-router/route/v1/driving
